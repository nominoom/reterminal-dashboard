# Optional: Cloud Persistence for Vercel Deployment
# If you add Vercel KV or Upstash Redis (both offer 100% free tier),
# these environment variables will automatically be picked up by the server.

# Upstash Redis / Vercel KV REST API
# KV_REST_API_URL="https://..."
# KV_REST_API_TOKEN="..."

# Or Upstash Redis:
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."

# Optional: Admin PIN / password to protect /admin updates (optional)
# ADMIN_PASSWORD=""

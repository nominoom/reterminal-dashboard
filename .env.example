# -------------------------------------------------------------
# VERCEL GLOBAL CONFIG (Edge Config) STORE
# -------------------------------------------------------------
# When you link your Global Config Store (e.g. data_read_display) to your Vercel Project,
# Vercel automatically provides the read connection string:
# GLOBAL_CONFIG="https://edge-config.vercel.com/ecfg_9gc191rmgw1boxvq1sv2y8noqsyw?token=..."

# To enable /admin to push live updates directly to Global Config from the web interface,
# create a Vercel Access Token at https://vercel.com/account/tokens and set:
# VERCEL_API_TOKEN="your_vercel_access_token"

# (Optional: If your project belongs to a team, provide the Team ID)
# VERCEL_TEAM_ID="team_..."

# -------------------------------------------------------------
# ALTERNATIVE: Upstash Redis / Vercel KV REST API
# -------------------------------------------------------------
# KV_REST_API_URL="https://..."
# KV_REST_API_TOKEN="..."
# Or:
# UPSTASH_REDIS_REST_URL="https://..."
# UPSTASH_REDIS_REST_TOKEN="..."
